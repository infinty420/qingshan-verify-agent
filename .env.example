# ===== LLM 供应商（OpenAI 兼容协议，可热替换）=====
# local_demo：离线演示供应商（抽取式回答，无 API 依赖）；openai_compat：真实供应商
LLM_PROVIDER=local_demo
# 示例：切换到 Moonshot Kimi / DeepSeek / 通义 / OpenAI，只需以下三行：
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=kimi-k2

# ===== Embedding（可与 LLM 不同供应商）=====
EMBEDDING_PROVIDER=local_demo
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDING_MODEL=text-embedding-3-small

# ===== 数据库 =====
# Demo 默认 SQLite；生产切换 PostgreSQL + pgvector（示例 host 请替换为你的实例地址）：
# DATABASE_URL=postgresql+asyncpg://user:pass@your-pg-host:5432/verify_agent
# DATABASE_URL=sqlite+aiosqlite:///data/verify_agent.db

# ===== 应用 =====
SECRET_KEY=change-me-in-prod
TOKEN_EXPIRE_HOURS=24
TOP_K=5
RETRIEVAL_THRESHOLD=0.12
PORT=8790
